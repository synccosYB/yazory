diff --git a/templates/task_detail.html b/templates/task_detail.html
new file mode 100644
index 0000000..99dd15e
--- /dev/null
+++ b/templates/task_detail.html
@@ -0,0 +1,7 @@
+{% extends 'base.html' %}{% from 'macros.html' import token with context %}
+{% block content %}
+<div class="page-heading"><div><div class="eyebrow">{{ _('TASK') }} #{{ task.id }}</div><h1>{{ task.title }}</h1><p>{% if task.family %}{{ _('Case') }}: <a href="{{ url_for('family_detail',family_id=task.family.id) }}">{{ task.family.name }}</a> · {% endif %}{{ _('Assigned to') }}: {{ task.assignee.name or task.assignee.email }}</p></div><a class="button secondary" href="{{ url_for('tasks') }}">{{ _('Back to tasks') }}</a></div>
+<div class="task-detail-grid"><section class="card padded"><div class="status-row"><div><h2>{{ _('Task details') }}</h2><p>{{ task.description or _('No instructions entered.') }}</p></div><span class="badge task-priority-{{ task.priority|lower }}">{{ _(task.priority) }}</span></div><dl class="details"><div><dt>{{ _('Created by') }}</dt><dd>{{ task.creator.name or task.creator.email }}</dd></div><div><dt>{{ _('Due date') }}</dt><dd class="numeric {% if task.due_date and task.due_date < today and task.status not in ['Completed','Cancelled'] %}task-overdue{% endif %}">{{ task.due_date|american_date if task.due_date else _('No due date') }}</dd></div><div><dt>{{ _('Status') }}</dt><dd>{{ _(task.status) }}</dd></div></dl><form method="post" action="{{ url_for('update_task_status',task_id=task.id) }}" class="compact-form">{{ token(csrf) }}<label>{{ _('Update status') }}<select name="status">{% for value in task_statuses %}<option value="{{ value }}" {{ 'selected' if task.status==value }}>{{ _(value) }}</option>{% endfor %}</select></label><button>{{ _('Save status') }}</button></form></section>
+{% if not task.parent_id %}<section class="card padded"><h2>{{ _('Add a subtask') }}</h2><form method="post" action="{{ url_for('add_subtask',task_id=task.id) }}">{{ token(csrf) }}<div class="form-grid"><label>{{ _('Subtask title') }}<input name="title" required maxlength="240"></label>{% if may_assign %}<label>{{ _('Assign to') }}<select name="assigned_to" required>{% for user in staff %}<option value="{{ user.id }}" {{ 'selected' if user.id==task.assigned_to }}>{{ user.name or user.email }}</option>{% endfor %}</select></label>{% endif %}<label>{{ _('Priority') }}<select name="priority">{% for value in task_priorities %}<option value="{{ value }}" {{ 'selected' if value==task.priority }}>{{ _(value) }}</option>{% endfor %}</select></label><label>{{ _('Due date') }}<input type="date" name="due_date" value="{{ task.due_date.isoformat() if task.due_date else '' }}"></label><label>{{ _('Instructions') }}<textarea name="description" rows="2" maxlength="5000"></textarea></label></div><div class="form-actions"><button>{{ _('Add subtask') }}</button></div></form></section>{% endif %}</div>
+{% if not task.parent_id %}<section class="card"><div class="section-heading"><div><h2>{{ _('Subtasks') }}</h2><p>{{ _('Break the assignment into clear steps, with a separate owner and due date for each.') }}</p></div><span class="count">{{ task.subtasks|selectattr('status','equalto','Completed')|list|length }}/{{ task.subtasks|length }}</span></div><div class="task-subtasks">{% for item in task.subtasks %}<article><div><a class="strong" href="{{ url_for('task_detail',task_id=item.id) }}">{{ item.title }}</a><small>{{ item.assignee.name or item.assignee.email }}{% if item.due_date %} · {{ item.due_date|american_date }}{% endif %}</small></div><span class="badge task-status-{{ item.status|lower|replace(' ','-') }}">{{ _(item.status) }}</span></article>{% else %}<p class="empty">{{ _('No subtasks yet.') }}</p>{% endfor %}</div></section>{% endif %}
+{% endblock %}
diff --git a/templates/tasks.html b/templates/tasks.html
new file mode 100644
index 0000000..132abb3
--- /dev/null
+++ b/templates/tasks.html
@@ -0,0 +1,6 @@
+{% extends 'base.html' %}{% from 'macros.html' import token with context %}
+{% block content %}
+<div class="page-heading"><div><div class="eyebrow">{{ _('TEAM WORK') }}</div><h1>{{ _('Tasks') }}</h1><p>{{ _('Assign work to staff members and collectors, then track every subtask through completion.') }}</p></div></div>
+{% if may_assign %}<section class="card padded"><h2>{{ _('Create and assign a task') }}</h2><form method="post">{{ token(csrf) }}<div class="form-grid"><label>{{ _('Task title') }}<input name="title" required maxlength="240"></label><label>{{ _('Assign to') }}<select name="assigned_to" required><option value="">{{ _('Choose staff or collector') }}</option>{% for user in staff %}<option value="{{ user.id }}">{{ user.name or user.email }} · {{ _({'organization_admin':'Organization administrator','family_admin':'Family administrator','office_employee':'Office employee','fundraiser':'Collector / fundraiser'}[user.role]) }}</option>{% endfor %}</select></label><label>{{ _('Family case (optional)') }}<select name="family_id"><option value="">{{ _('No case') }}</option>{% for family in families %}<option value="{{ family.id }}">{{ family.name }}</option>{% endfor %}</select></label><label>{{ _('Priority') }}<select name="priority">{% for value in task_priorities %}<option value="{{ value }}" {{ 'selected' if value=='Normal' }}>{{ _(value) }}</option>{% endfor %}</select></label><label>{{ _('Due date') }}<input type="date" name="due_date"></label><label>{{ _('Instructions') }}<textarea name="description" rows="3" maxlength="5000"></textarea></label></div><div class="form-actions"><button>{{ _('Create task') }}</button></div></form></section>{% endif %}
+<section class="card"><div class="section-heading"><div><h2>{{ _('Task list') }}</h2><p>{{ _('Open a task to update it or add subtasks.') }}</p></div><form method="get" class="inline-form"><label class="sr-only" for="task-status">{{ _('Status') }}</label><select id="task-status" name="status" onchange="this.form.submit()"><option value="">{{ _('All statuses') }}</option>{% for value in task_statuses %}<option value="{{ value }}" {{ 'selected' if selected_status==value }}>{{ _(value) }}</option>{% endfor %}</select></form></div><div class="table-wrap"><table><thead><tr>{% for label in ['Task','Assigned to','Case','Priority','Due date','Status','Progress'] %}<th>{{ _(label) }}</th>{% endfor %}</tr></thead><tbody>{% for task in tasks %}<tr><td><a class="strong" href="{{ url_for('task_detail',task_id=task.id) }}">{{ task.title }}</a>{% if task.description %}<small>{{ task.description|truncate(90) }}</small>{% endif %}</td><td>{{ task.assignee.name or task.assignee.email }}<small>{{ task.assignee.email if task.assignee.name else _({'organization_admin':'Organization administrator','family_admin':'Family administrator','office_employee':'Office employee','fundraiser':'Collector / fundraiser'}[task.assignee.role]) }}</small></td><td>{% if task.family %}<a href="{{ url_for('family_detail',family_id=task.family.id) }}">{{ task.family.name }}</a>{% else %}—{% endif %}</td><td><span class="badge task-priority-{{ task.priority|lower }}">{{ _(task.priority) }}</span></td><td class="numeric {% if task.due_date and task.due_date < today and task.status not in ['Completed','Cancelled'] %}task-overdue{% endif %}">{{ task.due_date|american_date if task.due_date else '—' }}</td><td><span class="badge task-status-{{ task.status|lower|replace(' ','-') }}">{{ _(task.status) }}</span></td><td>{{ task.subtasks|selectattr('status','equalto','Completed')|list|length }}/{{ task.subtasks|length }}</td></tr>{% else %}<tr><td colspan="7" class="empty">{{ _('No tasks found.') }}</td></tr>{% endfor %}</tbody></table></div></section>
