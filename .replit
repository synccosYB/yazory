entrypoint = "app_entry_intake.py"
modules = ["python-3.11", "postgresql-16", "nodejs-24"]
run = "APP_ENV=production python -m gunicorn --bind 0.0.0.0:5000 --error-logfile - --capture-output 'app_entry_intake:create_app()'"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
build = ["sh", "-c", "pip install -r requirements.txt && rm -f .pythonlibs/bin/pybidi"]
run = ["sh", "-c", "APP_ENV=production exec gunicorn --bind 0.0.0.0:${PORT:-5000} --error-logfile - --capture-output 'app_entry_intake:create_app()'"]
deploymentTarget = "autoscale"

[nix]
packages = ["postgresql", "psmisc", "iproute2", "nodejs_20"]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "APP_ENV=production python -m gunicorn --bind 0.0.0.0:5000 --error-logfile - --capture-output 'app_entry_intake:create_app()'"
waitForPort = 5000
